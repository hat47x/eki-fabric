          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "artifacts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/ArtifactDescriptor"
            }
          },
          "assurance": {
            "$ref": "#/components/schemas/PublicAssuranceSummary"
          }
        }

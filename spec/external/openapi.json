          "safe_processing": {
            "type": "string",
            "enum": [
              "not-required",
              "pending",
              "passed",
              "failed"
            ]
          },
          "provenance": {
            "type": "string",
            "enum": [
              "unassessed",
              "recorded",
              "rejected"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "staging",
              "available",
              "rejected"
            ]
          }
        }

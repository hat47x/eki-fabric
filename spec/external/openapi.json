      "ArtifactDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "artifact_id",
          "size_bytes",
          "media_type",
          "data_class",
          "facets"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "eki.artifact-descriptor/v1"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17592186044416
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "data_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "facets": {
            "$ref": "#/components/schemas/ArtifactFacetState"
          }
        },
        "description": "A digest may be absent until content identity is finalized. The facets are independent; no single trusted=true bit exists."
      },
      "ArtifactIngestIntentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "declared_size_bytes",
          "media_type",
          "requested_data_class"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "eki.artifact-ingest-intent-request/v1"
          },
          "declared_size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 17592186044416
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "requested_data_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
